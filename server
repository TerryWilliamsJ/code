const mongoose = require('mongoose')

const productSchema = mongoose.Schema({
  name:String,
  quantity:Number,
  price:Number
});

const productModel = mongoose.model('Customer',productSchema,'datas')
module.exports = productModel


const express = require('express')
const cors = require('cors')
const productModel = require('./Product')
const mongoose = require('mongoose')

const app = express()
app.use(express.json())
app.use(cors())

mongoose.connect('mongodb://localhost:27017/Customer')
.then(()=>console.log("connected"))
.catch(err=>console.log(err))

app.post('/addProduct',async(req,res)=>{
    try{
        await productModel.create(req.body)
        res.json({message:'added'})
    }
    catch(error){
        res.json(error)
    }
})



app.get('/getProduct/:id',async(req,res)=>{
    try{
        const product = await productModel.findById(req.params.id)
        res.json(product)
    }
    catch(error){
        res.json(error)
    }
})


app.put('/updateProduct/:id',async(req,res)=>{
    try{
    const product = await productModel.findByIdAndUpdate(req.params.id,req.body,{new:true})
    if(!product){
        res.json("Not found")
    }
    }
    catch(error){
        res.json(error)
    }
})

app.delete('/deleteProduct/:id',async(req,res)=>{
    
    try{
        const delprd=await productModel.findByIdAndDelete(req.params.id)
        if(!delprd){
            return res.json("Not found")
        }
        res.json({message:"pdt deleted"})
    }catch(error){
        res.json(error)
    }
})

PORT = 9000
app.listen(PORT,()=>{
    console.log("server is listening")
})
